#---------------------------------------------------------------------------
# Video: CH7301C #1 (DVI-I) and #2 (micro-HDMI), rtl/vga/g2_video.v; both encoders on the Chrontel I2C bus E8/D9 of the USB
# wrapper (rtl/g2/g2_usb_host.v +0x28, shared with the video page).  The HDMI DDC balls stay the console UART.  Data and
# syncs leave ODDR2s on oclk (2 x pixel clock, 50..130 MHz and 53.571 MHz for mode 4); XCLK is the same ODDR2 pair.
#---------------------------------------------------------------------------
NET "dvi_d[0]"             LOC = D17  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L66N_SCP0_0  [T,Tsp] T:36 V1_D[0]
NET "dvi_d[1]"             LOC = A14  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L50N_0  [T,Tsp] T:37 V1_D[1]
NET "dvi_d[2]"             LOC = A15  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L51N_0  [T,Tsp] T:38 V1_D[2]
NET "dvi_d[3]"             LOC = A16  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L63N_SCP6_0  [T,Tsp] T:39 V1_D[3]
NET "dvi_d[4]"             LOC = A17  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L64N_SCP4_0  [T,Tsp] T:40 V1_D[4]
NET "dvi_d[5]"             LOC = A18  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L65N_SCP2_0  [T,Tsp] T:41 V1_D[5]
NET "dvi_d[6]"             LOC = D14  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L49P_0  [T,Tsp] T:42 V1_D[6]
NET "dvi_d[7]"             LOC = B14  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L50P_0  [T,Tsp] T:43 V1_D[7]
NET "dvi_d[8]"             LOC = B16  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L63P_SCP7_0  [T,Tsp] T:44 V1_D[8]
NET "dvi_d[9]"             LOC = B18  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L65P_SCP3_0  [T,Tsp] T:45 V1_D[9]
NET "dvi_d[10]"            LOC = E16  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L66P_SCP1_0  [T,Tsp] T:46 V1_D[10]
NET "dvi_d[11]"            LOC = D15  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L62P_0  [T,Tsp] T:47 V1_D[11]
NET "dvi_xclk_p"           LOC = E14  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L47P_0  [T,Tsp] T:48 V1_XCLK_P
NET "dvi_xclk_n"           LOC = F15  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L47N_0  [T,Tsp] T:49 V1_XCLK_N
NET "dvi_h"                LOC = F12  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L44N_0  [T,Tsp] T:50 V1_HSYNC -- HSYNC
NET "dvi_v"                LOC = C16  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L62N_VREF_0  [T,Tsp] T:51 V1_VSYNC -- VSYNC
NET "dvi_de"               LOC = F14  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b0 IO_L48P_0  [T,Tsp] T:52 V1_DE
NET "dvi_reset_n"          LOC = C15  | IOSTANDARD = LVCMOS33;   # out b0 IO_L51P_0  [T,Tsp] T:53 V1_RESET_N -- T-README B2B ta
NET "dvi_hpint_n"          LOC = D13  | IOSTANDARD = LVCMOS33;   # in  b0 IO_L45N_0  [T] T:56 V1_HPINT -- CH7301C hot-plug inte
NET "hdmi_d[0]"            LOC = T18  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L4P_2  [T,Tsp] T:59 V2_D[0]
NET "hdmi_d[1]"            LOC = U16  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L8N_2  [T,Tsp] T:60 V2_D[1]
NET "hdmi_d[2]"            LOC = V17  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L11P_2  [T,Tsp] T:61 V2_D[2]
NET "hdmi_d[3]"            LOC = V19  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L9P_2  [T,Tsp] T:62 V2_D[3]
NET "hdmi_d[4]"            LOC = V18  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L9N_2  [T,Tsp] T:63 V2_D[4]
NET "hdmi_d[5]"            LOC = W17  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L11N_2  [T,Tsp] T:64 V2_D[5]
NET "hdmi_d[6]"            LOC = Y17  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L15P_2  [T,Tsp] T:65 V2_D[6]
NET "hdmi_d[7]"            LOC = Y15  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L21P_2  [T,Tsp] T:66 V2_D[7]
NET "hdmi_d[8]"            LOC = Y18  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L6N_2  [T,Tsp] T:67 V2_D[8]
NET "hdmi_d[9]"            LOC = Y19  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L5P_2  [T,Tsp] T:68 V2_D[9]
NET "hdmi_d[10]"           LOC = AB21 | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L2N_CMPMOSI_2  [T,Tsp] T:69 V2_D[10]
NET "hdmi_d[11]"           LOC = T17  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L4N_VREF_2  [T,Tsp] T:70 V2_D[11]
NET "hdmi_xclk_p"          LOC = T15  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L7N_2  [T,Tsp] T:71 V2_XCLK_P
NET "hdmi_h"               LOC = AB15 | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L21N_2  [T,Tsp] T:72 V2_HSYNC -- HSYNC
NET "hdmi_v"               LOC = T16  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L7P_2  [T,Tsp] T:73 V2_VSYNC -- VSYNC
NET "hdmi_de"              LOC = AB16 | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 24;   # out b2 IO_L19N_2  [T,Tsp] T:74 V2_DE
NET "hdmi_reset_n"         LOC = W18  | IOSTANDARD = LVCMOS33;   # out b2 IO_L6P_2  [T,Tsp] T:75 V2_RESET_N
NET "hdmi_hpint_n"         LOC = AB18 | IOSTANDARD = LVCMOS33;   # in  b2 IO_L14N_D12_2  [T] T:78 V2_HPINT -- active low

# Global clock sites.  XST implements the MCB's BUFGCE (u_clk/u_bufg_drp) as a BUFGMUX, whose paired site must stay
# empty (both of a pair's inputs route through the mux); the placer put a BUFG in the pair once the video heads added
# three global clocks (ERROR:Place:1023).  The sites are the ones the placer chose while the pair was free (7d4304a);
# 14 of the 16 buffers are used (both video heads share one output clock DCM for that reason).
INST "u_clk/u_bufg_drp"  LOC = BUFGMUX_X2Y10;
INST "u_clk/u_bufg_sys"  LOC = BUFGMUX_X2Y2;
INST "u_clk/u_bufg_icap" LOC = BUFGMUX_X2Y12;
CONFIG PROHIBIT = BUFGMUX_X2Y9;

#---------------------------------------------------------------------------
# WM8750BL codec, I2S playback (rtl/g2/g2_audio.v): MCLK 24.000 MHz, the USB wrapper's clk24 (no global buffer is
# free for another clock); the codec is the I2S slave (BCLK, DACLRC, DACDAT from the fabric).  Balls from docs/g2/g2_pins_reference.ucf.
# The control I2C (U17/AB17) is i2c_a_* above.  ADCLRC (W9) and ADCDAT (R13) are not used: no input jack.
#---------------------------------------------------------------------------
NET "codec_mclk"    LOC = W14  | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 8;   # IO_L20P_2, T:101 ADC_MCLK
NET "codec_bclk"    LOC = AB13 | IOSTANDARD = LVCMOS33 | SLEW = FAST | DRIVE = 8;   # IO_L30N_GCLK0_USERCCLK_2, T:96 ADC_BCLK
NET "codec_daclrc"  LOC = U6   | IOSTANDARD = LVCMOS33;                             # IO_L63P_2, T:99 ADC_DACLRC
NET "codec_dacdat"  LOC = Y14  | IOSTANDARD = LVCMOS33;                             # IO_L20N_2, T:100 ADC_DACDAT
# Crossings clk_sys <-> clk24: the Gray-pointer FIFO (dp2/rtl/audio_ring.v) and the flush/lock synchronisers.
NET "clk24_aud" TNM_NET = "clk24";   # the top-level wire from u_usb clk24_o, as vclk and oclk1 above
TIMESPEC "TS_sys_to_clk24" = FROM "clk_sys" TO "clk24"   20 ns DATAPATHONLY;
TIMESPEC "TS_clk24_to_sys" = FROM "clk24"   TO "clk_sys" 20 ns DATAPATHONLY;
# The remaining ordered pairs of the clocks derived from TS_osc_clk (clk_cpu, clk_sys, clk_plb, clk_icap, vclk, oclk,
# clk24, the y13_clk groups etx_regs and y13_regs), each bounded at one period of the faster clock, DATAPATHONLY, so no
# crossing between two of them is timed as a synchronous path at their common derived period.  A pair the design does
# not cross reports 0 paths; each pair that does is listed with its synchroniser.  Clocks
# from pads without a PERIOD relation to TS_osc_clk (eth_rxc, ulpi_clk and the clocks derived from it, cfg_clk) are
# unrelated and not analysed across; their crossings are listed there as well.
TIMESPEC "TS_cpu_to_vclk"   = FROM "clk_cpu"  TO "vclk"     12.5 ns DATAPATHONLY;
TIMESPEC "TS_vclk_to_cpu"   = FROM "vclk"     TO "clk_cpu"  12.5 ns DATAPATHONLY;
TIMESPEC "TS_cpu_to_oclk"   = FROM "clk_cpu"  TO "oclk"     7.69 ns DATAPATHONLY;
TIMESPEC "TS_oclk_to_cpu"   = FROM "oclk"     TO "clk_cpu"  7.69 ns DATAPATHONLY;
TIMESPEC "TS_cpu_to_clk24"  = FROM "clk_cpu"  TO "clk24"    15 ns DATAPATHONLY;
TIMESPEC "TS_clk24_to_cpu"  = FROM "clk24"    TO "clk_cpu"  15 ns DATAPATHONLY;
TIMESPEC "TS_plb_to_vclk"   = FROM "clk_plb"  TO "vclk"     12.5 ns DATAPATHONLY;
TIMESPEC "TS_vclk_to_plb"   = FROM "vclk"     TO "clk_plb"  12.5 ns DATAPATHONLY;
TIMESPEC "TS_plb_to_oclk"   = FROM "clk_plb"  TO "oclk"     7.69 ns DATAPATHONLY;
TIMESPEC "TS_oclk_to_plb"   = FROM "oclk"     TO "clk_plb"  7.69 ns DATAPATHONLY;
TIMESPEC "TS_plb_to_icap"   = FROM "clk_plb"  TO "clk_icap" 16 ns DATAPATHONLY;
TIMESPEC "TS_icap_to_plb"   = FROM "clk_icap" TO "clk_plb"  16 ns DATAPATHONLY;
TIMESPEC "TS_plb_to_clk24"  = FROM "clk_plb"  TO "clk24"    16 ns DATAPATHONLY;
TIMESPEC "TS_clk24_to_plb"  = FROM "clk24"    TO "clk_plb"  16 ns DATAPATHONLY;
TIMESPEC "TS_icap_to_vclk"  = FROM "clk_icap" TO "vclk"     12.5 ns DATAPATHONLY;
TIMESPEC "TS_vclk_to_icap"  = FROM "vclk"     TO "clk_icap" 12.5 ns DATAPATHONLY;
TIMESPEC "TS_vclk_to_clk24" = FROM "vclk"     TO "clk24"    12.5 ns DATAPATHONLY;
TIMESPEC "TS_clk24_to_vclk" = FROM "clk24"    TO "vclk"     12.5 ns DATAPATHONLY;
TIMESPEC "TS_oclk_to_clk24" = FROM "oclk"     TO "clk24"    7.69 ns DATAPATHONLY;
TIMESPEC "TS_clk24_to_oclk" = FROM "clk24"    TO "oclk"     7.69 ns DATAPATHONLY;
TIMESPEC "TS_sys_to_etx"    = FROM "clk_sys"  TO "etx_regs" 8 ns DATAPATHONLY;
TIMESPEC "TS_etx_to_sys"    = FROM "etx_regs" TO "clk_sys"  8 ns DATAPATHONLY;
TIMESPEC "TS_plb_to_etx"    = FROM "clk_plb"  TO "etx_regs" 8 ns DATAPATHONLY;
TIMESPEC "TS_etx_to_plb"    = FROM "etx_regs" TO "clk_plb"  8 ns DATAPATHONLY;
TIMESPEC "TS_y13_to_cpu"    = FROM "y13_regs" TO "clk_cpu"  8 ns DATAPATHONLY;
TIMESPEC "TS_y13_to_sys"    = FROM "y13_regs" TO "clk_sys"  8 ns DATAPATHONLY;
TIMESPEC "TS_sys_to_y13"    = FROM "clk_sys"  TO "y13_regs" 8 ns DATAPATHONLY;

#---------------------------------------------------------------------------
# The CPU in one area group (the region of ise/floorplan/revb_cpu_ag.ucf, now in this file).  The CPU (rtl/vexiiriscv/VexRiscv_PanoG2.v and the core) in one region between the
# block-RAM columns RAMB16_X1 and RAMB16_X2 and the DSP column DSP48_X1, rows 40-151: 68 x 112 slices (7,616) for the
# core's 11,366 LUT and 7,206 FF of the out-of-context fit, 56 RAMB16 sites for its 11 RAMB16 and 41 RAMB8, 28 DSP48A1
# for its 9.  Without it the placer spread the core over slice columns 1-127 and the clk_cpu paths were
# route-dominated.  The site columns: RAMB16_X1 beside SLICE_X27, RAMB16_X2 beside SLICE_X43, DSP48_X1 beside SLICE_X33.
INST "u_soc/u_cpu/*" AREA_GROUP = "AG_cpu";
AREA_GROUP "AG_cpu" RANGE = SLICE_X20Y40:SLICE_X87Y151;
AREA_GROUP "AG_cpu" RANGE = RAMB16_X1Y20:RAMB16_X2Y74;
AREA_GROUP "AG_cpu" RANGE = RAMB8_X1Y20:RAMB8_X2Y75;
AREA_GROUP "AG_cpu" RANGE = DSP48_X1Y10:DSP48_X1Y37;
